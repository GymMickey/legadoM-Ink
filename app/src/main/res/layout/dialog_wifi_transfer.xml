<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="400dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- 二维码（缩小至 80dp） -->
    <ImageView
        android:id="@+id/iv_qr_code"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter" />

    <!-- WiFi 地址 -->
    <TextView
        android:id="@+id/tv_wifi_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:gravity="center"
        android:textIsSelectable="true" />

    <!-- 最近上传标题 + 清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最近上传"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_clear_uploads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 上传历史列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_upload_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- 上传历史空态 -->
    <TextView
        android:id="@+id/tv_upload_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无上传记录"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="visible" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider" />

    <!-- 剪贴板预览标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="剪贴板历史"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 剪贴板预览列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_clipboard_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false" />

    <!-- 占位文本（无数据时显示） -->
    <TextView
        android:id="@+id/tv_clipboard_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="暂无剪贴板数据"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="visible" />

</LinearLayout>