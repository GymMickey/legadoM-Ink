<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTP remains available to user-managed book sources for compatibility.
        App-owned update/sync/backup clients enforce HTTPS separately.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>