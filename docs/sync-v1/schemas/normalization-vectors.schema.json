{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legadom-ink.invalid/sync-v1/schemas/normalization-vectors.schema.json",
  "title": "Sync v1 normalization test vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "normalization_version",
    "unicode_data_version",
    "vectors"
  ],
  "properties": {
    "protocol_version": {
      "const": "sync-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "normalization_version": {
      "const": "normalization-v1"
    },
    "unicode_data_version": {
      "const": "15.1.0"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "description",
          "input_text",
          "normalized_text",
          "normalized_codepoint_count",
          "sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_text": {
            "type": "string"
          },
          "normalized_text": {
            "type": "string"
          },
          "normalized_codepoint_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
