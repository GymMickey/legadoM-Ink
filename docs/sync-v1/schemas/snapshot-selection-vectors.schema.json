{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legadom-ink.invalid/sync-v1/schemas/snapshot-selection-vectors.schema.json",
  "title": "Sync v1 immutable projection selection vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "normalization_version",
    "vectors"
  ],
  "properties": {
    "protocol_version": {
      "const": "sync-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "normalization_version": {
      "const": "normalization-v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "projection_kind",
          "candidates",
          "expected_outcome",
          "selected_revision",
          "selected_snapshot_id"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "projection_kind": {
            "enum": [
              "catalog",
              "chapters",
              "progress",
              "device_state"
            ]
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "snapshot_id",
                "path_revision",
                "path_snapshot_id",
                "path",
                "device_id",
                "work_id",
                "payload_utf8",
                "payload_sha256"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "snapshot_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "path_revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "path_snapshot_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "device_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "work_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "payload_utf8": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 16384
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "expected_outcome": {
            "enum": [
              "selected",
              "revision_conflict",
              "no_valid_candidate"
            ]
          },
          "selected_revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selected_snapshot_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
